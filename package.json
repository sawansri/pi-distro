{
  "name": "pi-distro",
  "version": "0.1.0",
  "description": "A pi distro for local models on Strix Halo: small prompt, stable prompt cache, deep research.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/tool-loadout.ts",
      "./extensions/subagents.ts",
      "./extensions/lean-prompt.ts",
      "./extensions/cache-guard.ts",
      "./extensions/plan-mode.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0"
  },
  "scripts": {
    "test": "node --test test/*.test.ts"
  },
  "files": [
    "agents",
    "extensions",
    "skills",
    "config",
    "scripts",
    "install.sh",
    "LICENSE"
  ]
}
