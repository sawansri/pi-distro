{
  "name": "pi-distro",
  "version": "0.1.0",
  "description": "A pi distro for hosted models behind an LLM gateway: cheap subagents, real cost reporting, per-model APIs.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/tool-loadout.ts",
      "./extensions/lean-prompt.ts",
      "./extensions/cache-guard.ts",
      "./extensions/plan-mode.ts",
      "./extensions/guard.ts",
      "./extensions/remember.ts",
      "./extensions/handoff.ts",
      "./extensions/notify.ts",
      "./extensions/models-refresh.ts",
      "./extensions/costs.ts",
      "./extensions/review-context.ts",
      "./extensions/working-timer.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0"
  },
  "scripts": {
    "test": "node --test test/*.test.ts"
  },
  "files": [
    "agents",
    "extensions",
    "config",
    "providers",
    "scripts",
    "install.sh",
    "LICENSE",
    "README.md"
  ]
}
